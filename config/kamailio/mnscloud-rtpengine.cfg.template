loadmodule "rtpengine.so"

modparam("rtpengine", "rtpengine_sock", "{{RTPENGINE_SOCKET}}")
modparam("rtpengine", "extra_id_pv", "$avp(mns_rtp_branch)")

route[MNSCLOUD_RTPENGINE_OFFER] {
    if (has_body("application/sdp")) {
        $avp(mns_rtp_branch) = "mns-webrtc";
        if ($si == "127.0.0.1") {
            if (!rtpengine_offer("replace-origin replace-session-connection RTP/AVP ICE=remove DTLS=off rtcp-mux-demux via-branch=extra")) {
                xlog("L_ERR", "MNSCloud WebRTC rtpengine_offer to SIP failed callid=$ci source=$si ruri=$ru\n");
                sl_send_reply("488", "SIP media negotiation failed");
                exit;
            }
            return;
        }

        if (!rtpengine_offer("replace-origin replace-session-connection RTP/SAVPF ICE=force DTLS=passive SDES-off rtcp-mux-offer rtcp-mux-accept no-rtcp-attribute codec-mask-G729 via-branch=extra")) {
            xlog("L_ERR", "MNSCloud WebRTC rtpengine_offer to WebRTC failed callid=$ci source=$si ruri=$ru\n");
            sl_send_reply("488", "WebRTC media negotiation failed");
            exit;
        }
    }
}

route[MNSCLOUD_RTPENGINE_ANSWER] {
    if (has_body("application/sdp")) {
        $avp(mns_rtp_branch) = "mns-webrtc";
        if ($si == "127.0.0.1") {
            if (!rtpengine_answer("replace-origin replace-session-connection RTP/AVP ICE=remove DTLS=off rtcp-mux-demux via-branch=extra")) {
                xlog("L_ERR", "MNSCloud WebRTC rtpengine_answer to SIP failed callid=$ci source=$si\n");
                drop;
            }
            return;
        }

        if (!rtpengine_answer("replace-origin replace-session-connection RTP/SAVPF ICE=force DTLS=passive SDES-off rtcp-mux-offer rtcp-mux-accept no-rtcp-attribute codec-mask-G729 via-branch=extra")) {
            xlog("L_ERR", "MNSCloud WebRTC rtpengine_answer to WebRTC failed callid=$ci source=$si\n");
            drop;
        }
    }
}
